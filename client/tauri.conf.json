{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaxelium",
  "version": "0.1.0",
  "identifier": "com.creativecodecat.vaxelium",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vaxelium",
        "width": 1200,
        "height": 760,
        "minWidth": 820,
        "minHeight": 480,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
