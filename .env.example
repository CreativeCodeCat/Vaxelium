# Example settings for the Vaxelium server and client.
#
# Copy this file to `.env` in the folder you start the server or client from, and change the
# values you need. Settings already set in your shell take priority over `.env`.

# --- Server ---

# Address other servers and clients use to reach this server. Leave unset to use the LAN address
# (only used when running a single server; a group uses each server's own LAN address).
VAXELIUM_ADVERTISE=127.0.0.1:7878

# UDP port for finding servers on the local network. Each server in a group uses the next one up.
VAXELIUM_DISCOVERY_PORT=7879

# Seconds between asking known servers for their lists.
VAXELIUM_EXCHANGE_SECS=30

# Servers to start from, comma separated. For finding servers across the internet.
# A group's first server uses these and knows every other server in the group.
VAXELIUM_PEERS=127.0.0.1:7878

# Where the server serves the web client (http://host:port in a browser), or "off". Build it first
# with `cargo xtask web`. By default it
# is the first port past the server group: 7880 for one server on 7878. It is plain HTTP, so put it
# behind an HTTPS proxy before using it over the internet.
VAXELIUM_WEB_ADDR=0.0.0.0:7880

# The folder the web client is served from, if not the one `cargo xtask web` writes
# (server/web/dist).
VAXELIUM_WEB_DIR=server/web/dist

# Server command line, for reference:
#   server [ADDR] [DB_PATH] [AUTH_ADDR] [COUNT]
#   e.g. server 127.0.0.1:7878 vaxelium.db 127.0.0.1:7900 3

VAXELIUM_TERMS_URL=https://5646316.xyz/terms
VAXELIUM_PRIVACY_URL=https://5646316.xyz/privacy

# --- Client ---

# Address of the auth service that holds accounts.
VAXELIUM_AUTH=127.0.0.1:7900

# --- Auth service ---

# Login with Discord. Create an application at https://discord.com/developers/applications and copy its
# Client ID and Client Secret. Discord login stays off until all three Discord settings are set.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The address Discord sends the browser back to. Register this exact URL under OAuth2 in the portal.
# On your own machine: http://127.0.0.1:8080/discord/callback
# On a domain (nginx in front of the auth service): https://login.example.com/discord/callback
DISCORD_REDIRECT_URI=http://127.0.0.1:8080/discord/callback
# The address the auth service listens on for that URL, e.g. 127.0.0.1:8080. With a domain, point nginx
# at this address.
DISCORD_CALLBACK_ADDR=127.0.0.1:8080

RESEND_API_KEY=
VAXELIUM_MAIL_FROM=